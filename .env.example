APP_ENV=development
APP_NAME=SINEDIS Bitrix24 Automation
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8010
APP_BASE_URL=http://localhost:8010
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://bitrix_app:change_me@localhost:5432/bitrix_automation

BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Generate ENCRYPTION_KEY with: make generate-encryption-key
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

ADMIN_API_TOKEN=

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=50
WORKER_LOCK_TIMEOUT_SECONDS=120
WORKER_RECOVERY_INTERVAL_SECONDS=60
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_RETRY_JITTER_SECONDS=2

SHORT_PAUSE_MIN_SECONDS=1
SHORT_PAUSE_MAX_SECONDS=3600

BITRIX_HTTP_CONNECT_TIMEOUT_SECONDS=5
BITRIX_HTTP_READ_TIMEOUT_SECONDS=20
BITRIX_HTTP_WRITE_TIMEOUT_SECONDS=20
BITRIX_HTTP_POOL_TIMEOUT_SECONDS=5
BITRIX_HTTP_MAX_CONNECTIONS=20

BITRIX_OAUTH_EXPIRY_SKEW_SECONDS=60
BITRIX_OAUTH_CONNECT_TIMEOUT_SECONDS=5
BITRIX_OAUTH_READ_TIMEOUT_SECONDS=20
